# ── Telegram (Telethon / MTProto user login) ────────────────────────────────
# api_id / api_hash from https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=changeme
# Phone for first-time Telethon login (international format, e.g. +91...)
PHONE_NUMBER=
TELETHON_SESSION=tga_user
# Optional: route MTProto around ISP/DPI blocking. Leave empty if using a VPN.
#   socks5://[user:pass@]host:port | http://host:port | mtproxy://host:port:secret
TELEGRAM_PROXY=
# Bot API token from @BotFather (publishing + review bot, Phase 6/7)
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# ── LLM (Phase 6) ────────────────────────────────────────────────────────────
# Set Anthropic (plan default) and/or Groq.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Datastores ───────────────────────────────────────────────────────────────
# Any postgres scheme is accepted; sync/async forms are derived in config.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tga
REDIS_URL=redis://localhost:6379/0

# ── Supplementary analytics APIs (optional) ──────────────────────────────────
TGSTAT_API_KEY=
TELEMETR_API_KEY=

# ── Image API (photo posts) ───────────────────────────────────────────────────
# Free at https://www.pexels.com/api/ — sign up takes 30 seconds.
# Without this key, photo strategy slots fall back to text format.
PEXELS_API_KEY=

# ── Content scoring ──────────────────────────────────────────────────────────
SCORE_THRESHOLD=4
